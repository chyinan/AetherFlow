# AetherFlow final production-like demo environment.
DEPLOY_HOST=localhost
TZ=Asia/Shanghai

DB_HOST=mysql
DB_PORT=3306
DB_PUBLIC_PORT=3307
DB_NAME=aetherflow
DB_USERNAME=aetherflow_app
DB_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=aetherflow
MYSQL_USERNAME=aetherflow_app
MYSQL_PASSWORD=

NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_ADDR=nacos:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_INIT_DEFAULT_PASSWORD=nacos
NACOS_AUTH_TOKEN=
NACOS_AUTH_TOKEN_EXPIRE_SECONDS=18000
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=

SEATA_HOST=seata
SEATA_PORT=8091
SEATA_ADDR=seata:8091
SEATA_TX_GROUP=aetherflow_tx_group

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

MQ_HOST=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_SSL_PORT=5671
RABBITMQ_USERNAME=aetherflow
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
RABBITMQ_MANAGEMENT_USERNAME=aetherflow
RABBITMQ_MANAGEMENT_PASSWORD=

MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aetherflow

# Elasticsearch
ELASTIC_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

AI_RUNTIME_HOST=python-ai-service
PYTHON_AI_BASE_URL=http://python-ai-service:8200
WORKFLOW_CODE_EXECUTION_ENABLED=false
WORKFLOW_CODE_RUNTIME_ISOLATION_CONFIRMED=false
WORKFLOW_CODE_RUNTIME_URL=http://code-runtime-service:8300
WORKFLOW_CODE_RUNTIME_API_KEY=
CODE_RUNTIME_API_KEY=
CODE_RUNTIME_MAX_CONCURRENCY=2
CODE_RUNTIME_MAX_REQUEST_BYTES=1048576
PYTHON_AI_CONNECT_TIMEOUT_MILLIS=3000
PYTHON_AI_READ_TIMEOUT_MILLIS=120000
PYTHON_AI_STATUS_TIMEOUT_MILLIS=3000
ENABLE_WHISPER=false
ENABLE_LLM=false
WORKFLOW_AI_ASYNC_ENABLED=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MAX_CONCURRENCY=2
FFMPEG_MAX_CONCURRENCY=2
LLM_MAX_CONCURRENCY=8
FFMPEG_TIMEOUT_SECONDS=120
FILE_URL_REWRITE_FROM=http://localhost:9000
FILE_URL_REWRITE_TO=http://minio:9000

OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_DEFAULT_PROVIDER=OLLAMA
AI_DEFAULT_MODEL=qwen3:8b
WORKFLOW_EMBEDDING_MODEL=nomic-embed-text
WORKFLOW_EMBEDDING_VECTOR_STORE_PROVIDER=qdrant
WORKFLOW_EMBEDDING_IN_MEMORY_ENABLED=false
WORKFLOW_KNOWLEDGE_VECTOR_INDEX_REQUIRED=false
WORKFLOW_QDRANT_BASE_URL=https://qdrant-prod.example.com
WORKFLOW_QDRANT_API_KEY=
WORKFLOW_QDRANT_ENABLED=false

# Optional external image generation runtimes. Keep disabled until the endpoint,
# model inventory and network isolation have been verified by operations.
AI_IMAGE_DEFAULT_TIMEOUT=5m
AI_IMAGE_HEALTH_TIMEOUT=2s
AI_IMAGE_HEALTH_CACHE_TTL=10s
SD_WEBUI_ENABLED=false
SD_WEBUI_BASE_URL=http://host.docker.internal:7860
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_POLL_INTERVAL=1s
COMFYUI_MAX_WAIT=10m

SENTINEL_DASHBOARD=sentinel-dashboard:8858
JWT_SECRET=
JWT_REFRESH_SECRET=
FILE_INTERNAL_TOKEN=
TASK_INTERNAL_TOKEN=
AI_INTERNAL_TOKEN=
NOTIFY_INTERNAL_TOKEN=
AI_SERVICE_API_KEY=
NOTIFY_MAX_SSE_CONNECTIONS=10000
FRONTEND_BASE_URL=http://localhost
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost/api/auth/oauth/github/callback
GITHUB_OAUTH_SUCCESS_PATH=/auth/oauth/callback
GITHUB_OAUTH_FAILURE_PATH=/login
GITHUB_OAUTH_STATE_SECRET=

NGINX_HTTP_PORT=80
VITE_API_BASE=/api
VITE_WS_BASE=/ws
VITE_SSE_BASE=/sse
VITE_MOCK_FALLBACK=false
VITE_NOTIFY_WS_FALLBACK=false
VITE_RUNTIME_WS_FALLBACK=true
AETHERFLOW_WORKFLOW_ALLOWED_ORIGINS=http://localhost
WORKFLOW_RUNTIME_WS_STREAM_TIMEOUT=5m
WORKFLOW_RUNTIME_WS_POLL_INTERVAL=1s
WORKFLOW_RUNTIME_WS_HEARTBEAT_INTERVAL=15s
WORKFLOW_RUNTIME_WS_THREAD_POOL_SIZE=8
WORKFLOW_RUNTIME_WS_MAX_CONNECTIONS=2000
VITE_API_TIMEOUT_MS=15000

WORKFLOW_OCR_MOCK=false
WORKFLOW_OCR_PROVIDER=auto
WORKFLOW_DOCUMENT_MAX_FILE_BYTES=26214400
WORKFLOW_DOCUMENT_MAX_EXTRACTED_CHARACTERS=1000000
WORKFLOW_OCR_MOCK_TEXT=Demo safe OCR text for AetherFlow.
WORKFLOW_RUNTIME_EVENT_MQ_ENABLED=false
WORKFLOW_RUNTIME_LOCK_ENABLED=true

TASK_QUEUE_PROTECTION_ENABLED=true
TASK_QUEUE_BUSY_DEPTH_THRESHOLD=1000
TASK_QUEUE_RECOVERY_DEPTH_THRESHOLD=300
TASK_CONSUMER_DEAD_LETTER_ENABLED=true
TASK_CONSUMER_DISPATCH_ENABLED=true
AI_JOB_LEASE_DURATION=2m
AI_JOB_LEASE_HEARTBEAT_INTERVAL=30s
