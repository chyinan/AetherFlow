  },
  {
    "name": "转义斜线",
    "sample": {
      "a/b": "slash"
    },
    "path": "/a~1b",
    "type": "STRING",
    "expected": "slash"
  },
  {
    "name": "转义波浪号",
    "sample": {
      "a~b": "tilde"
    },
    "path": "/a~0b",
    "type": "STRING",
    "expected": "tilde"
  },
  {
    "name": "转义只解码一次",
    "sample": {
      "~1": "once",
      "/": "slash"
    },
    "path": "/~01",
    "type": "STRING",
    "expected": "once"
  },
  {
    "name": "连续波浪转义边界",
    "sample": {
      "~01": "once-again"
    },
    "path": "/~001",
    "type": "STRING",
    "expected": "once-again"
  },
  {
    "name": "嵌套转义后数组",
    "sample": {
      "a/b": {
        "~key": [
          42
        ]
      }
    },
    "path": "/a~1b/~0key/0",
    "type": "NUMBER",
    "expected": 42
  },
  {
    "name": "数组里的对象length合法",
    "sample": [
      {
        "length": 7
      }
    ],
    "path": "/0/length",
    "type": "NUMBER",
    "expected": 7
  },
