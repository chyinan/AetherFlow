            <stringProp name="Argument.value">${__P(upload_file_path,performance-test/data/sample-upload.txt)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ai_model" elementType="Argument">
            <stringProp name="Argument.name">ai_model</stringProp>
            <stringProp name="Argument.value">${__P(ai_model,llama3)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
