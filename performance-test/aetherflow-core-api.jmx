<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="AetherFlow Core API Performance Test" enabled="true">
      <stringProp name="TestPlan.comments">Gateway-based performance scenario for AetherFlow core APIs.</stringProp>
