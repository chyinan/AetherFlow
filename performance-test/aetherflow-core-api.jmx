        <hashTree/>
        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert successful Result envelope" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"><![CDATA[
def body = prev.getResponseDataAsString()
if (body == null) {
    return
}
def trimmed = body.trim()
if (!trimmed.startsWith('{') || !trimmed.contains('"code"')) {
    return
}
try {
    def json = new groovy.json.JsonSlurper().parseText(trimmed)
    if (json instanceof Map && json.containsKey('code')) {
        def code = json.code as Integer
        if (code != 0 && code != 200) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage("AetherFlow Result code was ${code}: ${json.message}")
        }
    }
} catch (Exception ignored) {
    // Non-JSON or binary responses are validated by HTTP status.
}
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Assertion>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Build per-iteration test data" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"><![CDATA[
def prefix = props.get('test_user_prefix') ?: 'perf_user'
def password = props.get('test_password') ?: 'PerfPass123!'
def shortId = java.util.UUID.randomUUID().toString().replace('-', '').take(8)
def unique = "${ctx.getThreadNum()}_${vars.getIteration()}_${System.currentTimeMillis()}_${shortId}"

vars.put('username', "${prefix}_${unique}".replaceAll('[^A-Za-z0-9_\\-]', '_'))
vars.put('password', password)
vars.put('workflow_name', "jmeter_workflow_${unique}")
vars.put('sample_text', props.get('sample_text') ?: 'AetherFlow performance test content for summary, translation, subtitle and notification flows.')
vars.put('auth_header', '')
vars.put('access_token', '')
vars.put('user_id', '0')
vars.put('definition_id', '')
vars.put('instance_id', '')
vars.put('file_id', '')
vars.put('file_url', props.get('file_url') ?: 'https://example.com/aetherflow-sample.wav')
]]></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
